# Rename this file to .env and fill in your Binance Futures Testnet credentials.
# Get your API keys from: https://testnet.binancefuture.com → Profile → API Management
# WARNING: Never commit the real .env file to version control.

BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here
